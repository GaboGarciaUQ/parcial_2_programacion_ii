<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" spacing="20" styleClass="vista" fx:controller="com.uniquindio.co.controlador.ActividadesController">
    <VBox spacing="10" prefWidth="290" minWidth="290" styleClass="tarjeta">
        <Label text="Datos de la actividad" styleClass="titulo"/>
        <TextField fx:id="tfCodigo" promptText="Código"/>
        <TextField fx:id="tfNombre" promptText="Nombre"/>
        <TextField fx:id="tfMunicipio" promptText="Municipio"/>
        <TextField fx:id="tfHoras" promptText="Duración en horas"/>
        <TextField fx:id="tfPrecio" promptText="Precio por persona (COP)"/>
        <TextField fx:id="tfCupo" promptText="Cupo máximo por día"/>
        <ComboBox fx:id="cbDificultad" promptText="Nivel de dificultad" maxWidth="Infinity"/>
        <ComboBox fx:id="cbEstado" maxWidth="Infinity"/>
<FlowPane hgap="8" vgap="8">
    <Button text="Registrar" onAction="#registrar" styleClass="boton-principal"/>
    <Button text="Guardar cambios" onAction="#actualizar" styleClass="boton-secundario"/>
    <Button text="Limpiar" onAction="#limpiar" styleClass="boton-suave"/>
</FlowPane>
    </VBox>
    <TableView fx:id="tabla" HBox.hgrow="ALWAYS"/>
</HBox>
